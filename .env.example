# Valores ilustrativos: reemplazalos por las credenciales de tu PostgreSQL local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navidad_magica?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
CODE_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# Origin check for participation requests; set to the canonical app origin in deployment.
APP_URL="http://localhost:3000"
# Absolute public base URL used to generate QR/NFC links; replace this example before use.
# For a phone on the same Wi-Fi, use the computer LAN IP, e.g. http://192.168.1.20:3000.
APP_BASE_URL="https://example.invalid"
# QA is disabled by default. Enable only against a distinct database with qa/test in its name.
QA_MODE="false"
# Must be separate from DATABASE_URL; only this database is migrated by QA scripts.
QA_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navidad_magica_qa?schema=public"
QA_ADMIN_EMAIL=""
QA_ADMIN_PASSWORD=""
# Optional for the first local bootstrap only. Keep real values out of the repository.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
